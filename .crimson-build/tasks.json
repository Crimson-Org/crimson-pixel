// crimson-build writes each task as a .sh script for Linux and macOS and a .cmd script for
// Windows in this folder, and those scripts run anywhere without Crimson Build.
{
	"systems": ["unix"],
	"env": {
		"PROGRAM": "crimson-pixel",
		"APPLICATION_ID": "io.github.CrimsonOrg.CrimsonPixel",
		"VERSION": "0.1.0",
		"PREFIX": "${HOME}/.local",
		"STD": "c11",
		"WARN": "-Wall -Wextra -Wpedantic -Werror -Wno-unused-parameter",
		"OPT": "-O2 -g",
		"GTK_MINOR": "16",
		"ADWAITA_MINOR": "7",
		"PKGS": "gtk4 >= 4.${GTK_MINOR} libadwaita-1 >= 1.${ADWAITA_MINOR} libpanel-1 zlib",
		"LIBS": "-lm",
		"DEFINES": "-DAPPLICATION_VERSION=\"${VERSION}\"",
		"VERSION_CHECKS": "-DGDK_VERSION_MIN_REQUIRED=GDK_VERSION_4_${GTK_MINOR} -DGDK_VERSION_MAX_ALLOWED=GDK_VERSION_4_${GTK_MINOR} -DADW_VERSION_MIN_REQUIRED=ADW_VERSION_1_${ADWAITA_MINOR} -DADW_VERSION_MAX_ALLOWED=ADW_VERSION_1_${ADWAITA_MINOR}",
		"INCLUDES": "-Isrc -Isubprojects/crimson-core/src",
		"HEADERS": "src/*/*.h subprojects/crimson-core/src/*/*.h subprojects/crimson-core/src/*/*/*.h"
	},
	"tasks": {
		"build": {
			"description": "Build Crimson Pixel into the project folder",
			"steps": [
				{"needs": ["cc", "make", "pkg-config", "glib-compile-resources"]},
				{"pkg": "${PKGS}"},
				{"mkdir": ["build/obj"]},
				"glib-compile-resources --sourcedir assets --target build/resources.c --generate-source assets/crimson-pixel.gresource.xml",
				"glib-compile-resources --sourcedir subprojects/crimson-core/assets --target build/core-resources.c --generate-source subprojects/crimson-core/assets/crimson-core.gresource.xml",
				{"each": {"from": "src/*.c src/adjustments/*.c src/app/*.c src/canvas/*.c src/color/*.c src/document/*.c src/psd/*.c src/selection/*.c src/tools/*.c src/window/*.c subprojects/crimson-core/src/common/*/*.c", "to": "build/obj/{id}.o", "run": "cc -std=${STD} $WARN $OPT $DEFINES $VERSION_CHECKS $INCLUDES $(pkg-config --cflags \"$PKGS\" | sed \"s/-I/-isystem /g\") -c {from} -o {to}", "also": "${HEADERS}"}},
				{"each": {"from": "build/resources.c build/core-resources.c", "to": "build/obj/{id}.o", "run": "cc -std=gnu11 $OPT $(pkg-config --cflags gio-2.0) -c {from} -o {to}"}},
				"cc -o build/${PROGRAM} build/obj/*.o $(pkg-config --libs \"$PKGS\") $LIBS",
				{"copy": {"from": "build/${PROGRAM}", "to": ".${PROGRAM}.new"}},
				{"move": {"from": ".${PROGRAM}.new", "to": "${PROGRAM}"}},
				{"mkdir": ["logs"]}
			]
		},
		"run": {
			"description": "Build and start Crimson Pixel",
			"depends": "build",
			"steps": [
				"./${PROGRAM}"
			]
		},
		"install": {
			"description": "Install Crimson Pixel for the current user",
			"depends": "build",
			"steps": [
				"sh subprojects/crimson-core/scripts/install.sh"
			]
		},
		"uninstall": {
			"description": "Remove Crimson Pixel from the current user",
			"steps": [
				"sh subprojects/crimson-core/scripts/uninstall.sh"
			]
		},
		"archive": {
			"description": "Pack Crimson Pixel into a tar.gz archive in dist",
			"depends": "build",
			"steps": [
				"sh subprojects/crimson-core/scripts/package.sh"
			]
		},
		"appimage": {
			"description": "Pack Crimson Pixel into an AppImage in dist",
			"depends": "build",
			"steps": [
				{"needs": ["quick-sharun"]},
				"sh subprojects/crimson-core/scripts/appimage.sh"
			]
		},
		"clean": {
			"description": "Remove the build folder",
			"steps": [
				{"remove": "build"}
			]
		}
	}
}
